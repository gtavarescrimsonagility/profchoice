{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "meta": {
    "title": "Professionals Choice",
    "author": "gtavarescrimsonagility",
    "description": "Playground environment for the Professionals Choice site."
  },
  "landingPage": "/",
  "preferredVersions": { "php": "8.4", "wp": "latest" },
  "login": true,
  "siteOptions": {
    "blogname": "Professionals Choice",
    "blogdescription": ""
  },
  "steps": [
    {
      "step": "installTheme",
      "themeData": { "resource": "bundled", "path": "/commercebuild-velocity.0.12.77.zip" },
      "options": { "activate": true },
      "ifAlreadyInstalled": "overwrite"
    },
    {
      "step": "setSiteOptions",
      "options": { "permalink_structure": "/%year%/%monthnum%/%day%/%postname%/" }
    }
  ]
}
