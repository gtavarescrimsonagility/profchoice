{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "profchoice/wishlist-button",
	"version": "0.2.0",
	"title": "Wishlist Button",
	"category": "profchoice",
	"icon": "heart",
	"description": "Heart that saves the product to the visitor's wishlist (filled when saved) and opens the Saved to dialog.",
	"keywords": [ "wishlist", "favorite", "heart", "save" ],
	"textdomain": "profchoicecore",
	"usesContext": [ "postId" ],
	"attributes": {
		"productId": {
			"type": "number"
		}
	},
	"supports": {
		"html": false,
		"color": {
			"text": true,
			"background": true
		},
		"spacing": {
			"margin": true,
			"padding": true
		},
		"interactivity": true
	},
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"viewScriptModule": "profchoice-wishlist-store",
	"render": "file:./render.php"
}
