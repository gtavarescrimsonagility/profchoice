{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "profchoice/carousel-indicators",
	"version": "0.1.0",
	"title": "Carousel Indicators",
	"category": "profchoice",
	"icon": "ellipsis",
	"description": "One indicator per slide. The Default style applies to every indicator; the Active one only overrides what differs.",
	"ancestor": [ "profchoice/carousel" ],
	"textdomain": "profchoicecore",
	"attributes": {
		"overlay": {
			"type": "boolean",
			"default": true
		},
		"default": {
			"type": "object"
		},
		"active": {
			"type": "object"
		}
	},
	"supports": {
		"html": false,
		"reusable": false,
		"spacing": {
			"margin": true,
			"padding": true,
			"blockGap": true
		},
		"layout": {
			"allowSwitching": false,
			"allowInheriting": false,
			"allowOrientation": false,
			"default": {
				"type": "flex",
				"flexWrap": "nowrap",
				"justifyContent": "center"
			}
		},
		"interactivity": true
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
