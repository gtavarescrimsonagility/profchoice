{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "profchoice/newsletter-message",
	"version": "0.1.0",
	"title": "Newsletter Message",
	"category": "profchoice",
	"icon": "feedback",
	"description": "A message shown after the newsletter form is submitted: on success, while waiting for the email confirmation (pending), or on error.",
	"ancestor": [ "profchoice/newsletter-form" ],
	"textdomain": "profchoicecore",
	"attributes": {
		"type": {
			"type": "string",
			"enum": [ "success", "pending", "error" ],
			"default": "success"
		}
	},
	"supports": {
		"html": false,
		"reusable": false,
		"color": {
			"background": true,
			"text": true,
			"link": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true
		},
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"editorStyle": "file:./index.css"
}
