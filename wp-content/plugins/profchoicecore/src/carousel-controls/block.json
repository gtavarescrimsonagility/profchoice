{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "profchoice/carousel-controls",
	"version": "0.7.0",
	"title": "Carousel Arrows",
	"category": "design",
	"icon": "leftright",
	"description": "Previous and next buttons of a carousel. Each arrow is a Button block (styles and hover/focus/active states); the Active/Inactive control settings style both arrows when enabled and when disabled.",
	"ancestor": [ "profchoice/carousel" ],
	"textdomain": "profchoicecore",
	"attributes": {
		"overlay": {
			"type": "boolean",
			"default": true
		},
		"active": {
			"type": "object",
			"default": {}
		},
		"inactive": {
			"type": "object",
			"default": {
				"opacity": "0.35"
			}
		}
	},
	"supports": {
		"html": false,
		"reusable": false,
		"spacing": {
			"margin": true,
			"padding": true
		},
		"interactivity": true
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
