{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "profchoice/carousel-control-next",
	"version": "0.14.0",
	"title": "Carousel Next",
	"category": "profchoice",
	"icon": "arrow-right-alt2",
	"description": "The next-slide button of a carousel. A Button block (styles and hover/focus/active states) with an Inline icon; the Active/Inactive control settings style it when enabled and when disabled.",
	"ancestor": [ "profchoice/carousel" ],
	"textdomain": "profchoicecore",
	"attributes": {
		"overlay": {
			"type": "boolean",
			"default": true
		},
		"active": {
			"type": "object"
		},
		"inactive": {
			"type": "object"
		}
	},
	"supports": {
		"html": false,
		"reusable": false,
		"spacing": {
			"margin": true,
			"padding": true
		},
		"dimensions": {
			"minWidth": true
		},
		"interactivity": true
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
