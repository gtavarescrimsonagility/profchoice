{
	"$schema": "https://schemas.wp.org/wp/7.1/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "1208px",
			"wideSize": "1208px"
		},
		"spacing": {
			"units": [ "px", "em", "rem", "%", "vh", "vw" ]
		},
		"typography": {
			"fontFamilies": [
				{
					"name": "Montserrat",
					"slug": "montserrat",
					"fontFamily": "Montserrat, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
					"fontFace": [
						{ "fontFamily": "Montserrat", "fontStyle": "normal", "fontWeight": "100 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/montserrat.woff2" ], "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD" },
						{ "fontFamily": "Montserrat", "fontStyle": "italic", "fontWeight": "100 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/montserrat-italic.woff2" ], "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD" }
					]
				},
				{
					"name": "Playfair Display",
					"slug": "playfair-display",
					"fontFamily": "\"Playfair Display\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
					"fontFace": [
						{ "fontFamily": "Playfair Display", "fontStyle": "normal", "fontWeight": "400 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/playfair-display.woff2" ], "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD" },
						{ "fontFamily": "Playfair Display", "fontStyle": "italic", "fontWeight": "400 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/playfair-display-italic.woff2" ], "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD" }
					]
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|cbv-background",
			"text": "var:preset|color|cbv-text"
		},
		"typography": {
			"fontFamily": "var:preset|font-family|montserrat"
		},
		"spacing": {
			"blockGap": "1.2rem"
		},
		"elements": {
			"button": {
				"typography": {
					"lineHeight": "1.495"
				},
				"spacing": {
					"padding": {
						"top": "calc(1.2rem + 1px)",
						"right": "calc(2.7rem + 1px)",
						"bottom": "calc(1.2rem + 1px)",
						"left": "calc(2.7rem + 1px)"
					}
				},
				"@mobile": {
					"typography": {
						"lineHeight": "1.13636364"
					},
					"spacing": {
						"padding": {
							"top": "calc(1rem + 1px)",
							"right": "calc(2.5rem + 1px)",
							"bottom": "calc(1rem + 1px)",
							"left": "calc(2.5rem + 1px)"
						}
					}
				},
				":hover": {
					"typography": {
						"textDecoration": "none"
					}
				}
			}
		},
		"blocks": {
			"core/heading": {
				"typography": {
					"fontFamily": "var:preset|font-family|playfair-display",
					"fontWeight": "600"
				}
			},
			"core/button": {
				"@mobile": {
					"typography": {
						"lineHeight": "1.13636364"
					},
					"spacing": {
						"padding": {
							"top": "calc(1rem + 1px)",
							"right": "calc(2.5rem + 1px)",
							"bottom": "calc(1rem + 1px)",
							"left": "calc(2.5rem + 1px)"
						}
					}
				}
			}
		}
	}
}
