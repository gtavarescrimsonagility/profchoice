	"styles": {
		"color": {
			"background": "var:preset|color|cbv-background",
			"text": "var:preset|color|cbv-text"
		},
		"typography": {
			"fontFamily": "var:preset|font-family|montserrat"
		},
		"spacing": {
			"blockGap": "1.2rem"
		},
		"elements": {
			"button": {
				"typography": {
					"lineHeight": "1.495"
				},
				"spacing": {
					"padding": {
						"top": "calc(1.2rem + 1px)",
						"right": "calc(2.7rem + 1px)",
						"bottom": "calc(1.2rem + 1px)",
						"left": "calc(2.7rem + 1px)"
					}
				},
				"@mobile": {
					"typography": {
						"lineHeight": "1.13636364"
					},
					"spacing": {
						"padding": {
							"top": "calc(1rem + 1px)",
							"right": "calc(2.5rem + 1px)",
							"bottom": "calc(1rem + 1px)",
							"left": "calc(2.5rem + 1px)"
						}
					}
				},
				":hover": {
					"typography": {
						"textDecoration": "none"
					}
				}
			}
		},
		"blocks": {
			"core/heading": {
				"typography": {
					"fontFamily": "var:preset|font-family|playfair-display",
					"fontWeight": "600"
				}
			},
			"core/button": {
				"@mobile": {
					"typography": {
						"lineHeight": "1.13636364"
					},
					"spacing": {
						"padding": {
							"top": "calc(1rem + 1px)",
							"right": "calc(2.5rem + 1px)",
							"bottom": "calc(1rem + 1px)",
							"left": "calc(2.5rem + 1px)"
						}
					}
				}
			}
		}
	}
}
