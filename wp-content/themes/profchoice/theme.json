{
	"$schema": "https://schemas.wp.org/wp/7.1/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "1208px",
			"wideSize": "1208px"
		},
		"spacing": {
			"units": [ "px", "em", "rem", "%", "vh", "vw" ]
		}
	},
	"styles": {
		"spacing": {
			"blockGap": "1.2rem"
		},
		"elements": {
			"button": {
				"typography": {
					"lineHeight": "1.495"
				},
				"spacing": {
					"padding": {
						"top": "calc(1.2rem + 1px)",
						"right": "calc(2.7rem + 1px)",
						"bottom": "calc(1.2rem + 1px)",
						"left": "calc(2.7rem + 1px)"
					}
				},
				"@mobile": {
					"typography": {
						"lineHeight": "1.13636364"
					},
					"spacing": {
						"padding": {
							"top": "calc(1rem + 1px)",
							"right": "calc(2.5rem + 1px)",
							"bottom": "calc(1rem + 1px)",
							"left": "calc(2.5rem + 1px)"
						}
					}
				}
			}
		},
		"blocks": {
			"core/heading": {
				"typography": {
					"fontFamily": "\"Playfair Display\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
					"fontWeight": "600"
				}
			},
			"core/button": {
				"@mobile": {
					"typography": {
						"lineHeight": "1.13636364"
					},
					"spacing": {
						"padding": {
							"top": "calc(1rem + 1px)",
							"right": "calc(2.5rem + 1px)",
							"bottom": "calc(1rem + 1px)",
							"left": "calc(2.5rem + 1px)"
						}
					}
				}
			}
		}
	}
}
