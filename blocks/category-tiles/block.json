{
	"$schema": "https://schemas.wp.org/wp/7.1/block.json",
	"apiVersion": 3,
	"name": "commercebuild/category-tiles",
	"title": "Category Tiles",
	"category": "commercebuild",
	"icon": "category",
	"description": "Grid of product category tiles with cached counts and images.",
	"keywords": [ "categories", "tiles", "woocommerce" ],
	"textdomain": "commercebuild-velocity",
	"attributes": {
		"heading": { "type": "string", "default": "" },
		"parent": { "type": "number", "default": 0 },
		"includeIds": { "type": "string", "default": "" },
		"limit": { "type": "number", "default": 8 },
		"columns": { "type": "number", "default": 4 },
		"showCount": { "type": "boolean", "default": true }
	},
	"supports": {
		"align": [ "wide", "full" ],
		"html": false
	},
	"editorScript": "cbv-blocks-editor",
	"render": "file:./render.php"
}
