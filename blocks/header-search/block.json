{
	"$schema": "https://schemas.wp.org/wp/7.1/block.json",
	"apiVersion": 3,
	"name": "commercebuild/header-search",
	"title": "Product Search",
	"category": "commercebuild",
	"icon": "search",
	"description": "Product search field. Routes through ElasticPress when active.",
	"textdomain": "commercebuild-velocity",
	"attributes": {
		"placeholder": { "type": "string", "default": "Search products…" },
		"buttonText": { "type": "string", "default": "Search" },
		"showButton": { "type": "boolean", "default": true },
		"buttonStyle": { "type": "string", "default": "text" },
		"showFieldIcon": { "type": "boolean", "default": true }
	},
	"supports": { "html": false },
	"editorScript": "cbv-blocks-editor",
	"render": "file:./render.php"
}
